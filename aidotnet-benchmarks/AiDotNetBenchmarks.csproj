<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- AiDotNet 0.207.9: latest framework release. Ships the #1457 LSTM
         fused-inference wiring (LSTMLayer<float>.Forward routes to
         CpuEngine.LstmSequenceForward in inference mode) plus subsequent fixes. -->
    <PackageReference Include="AiDotNet" Version="0.207.9" />
    <!-- Pin AiDotNet.Tensors 0.86.4 explicitly so we get the post-#436 perf
         block even if the transitive AiDotNet pin lags behind. v0.86.x ships:
           * Tensors #488 — fused QKV + transpose-fused SDPA. MHA on the AIsEval
             [128, 32, 64] h=4 shape: 5.31 -> 2.26 ms (beats torch ~2.74 ms).
           * Tensors #474 — small-batch native-BLAS thread cap inside MlpForward.
             AIsEval MLP (Dense 784->512->128->10 bs=128) p95 3.24 -> 1.75 ms.
           * Tensors #485 — output-only SDPA for fused MHA forward (6.9x less
             alloc, 2.7x mean latency).
           * Tensors #472 — Float32Precision opt-in for FusedAttention<double>
             (FP64 attention runs internally on float32).
           * Tensors #462 — hybrid hardware-aware GEMM strategy.
           * TensorArena.CreatePersistent / Activate — zero-GC training arena
             that survives across Train() steps.
         These are what the fair-comparison JSON should reflect. -->
    <PackageReference Include="AiDotNet.Tensors" Version="0.86.4" />
  </ItemGroup>
</Project>
